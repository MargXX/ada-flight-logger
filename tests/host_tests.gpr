with "config/host_tests_config.gpr";

project Host_Tests is
   for Source_Dirs use ("src/", "../src/core/", "config/");
   for Object_Dir use "obj/";
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("host_tests.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        Host_Tests_Config.Ada_Compiler_Switches & ("-gnata");
   end Compiler;
end Host_Tests;
